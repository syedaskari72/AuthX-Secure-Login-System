# Production Environment Variables Template
# Copy this file and fill in your production values

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/authx?retryWrites=true&w=majority

# JWT Configuration
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_random_string
JWT_EXPIRE=7d

# Email Configuration (Gmail Example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM=AuthX <noreply@authx.com>

# Twilio Configuration (SMS OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# OTP Configuration
OTP_EXPIRY_MINUTES=5

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# API URL (Backend)
VITE_API_URL=https://your-backend-domain.com/api

# ============================================
# NOTES
# ============================================

# 1. Never commit this file with real values
# 2. Use strong, unique passwords and secrets
# 3. Keep credentials secure and rotate regularly
# 4. Use environment variable management tools in production
# 5. Different platforms may require different formats